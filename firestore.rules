rules_version = '2';

// 留鼠看 — 房間成員制
//
// 每個房間有自己的成員名單（memberEmails）。
//   房號沒人用過 → 任何已驗證的 Google 帳號都能認領，認領者成為 owner
//   房號已經有人 → 只有名單上的人進得去，其他人一律擋掉
//   改名單       → 只有 owner
//
// 所以房號不再等於密碼：外流也沒用，沒被邀請就進不來。

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null
        && request.auth.token.email != null
        && request.auth.token.email_verified == true;
    }

    function myEmail() {
      return request.auth.token.email.lower();
    }

    function isMember(room) {
      return signedIn()
        && exists(/databases/$(database)/documents/rooms/$(room))
        && myEmail() in get(/databases/$(database)/documents/rooms/$(room)).data.memberEmails;
    }

    match /rooms/{room} {

      // 讀房間資料：名單上的人才行
      allow get: if signedIn()
        && resource.data.memberEmails is list
        && myEmail() in resource.data.memberEmails;

      // 不開放列出所有房間
      allow list: if false;

      // 認領空房：只在房間不存在時成立，且只能把自己一個人放進名單
      allow create: if signedIn()
        && request.resource.data.owner == request.auth.uid
        && request.resource.data.memberEmails is list
        && request.resource.data.memberEmails.size() == 1
        && request.resource.data.memberEmails[0] == myEmail();

      // 改成員名單：只有 owner，且不能把 owner 換掉、不能把自己踢掉
      allow update: if signedIn()
        && resource.data.owner == request.auth.uid
        && request.resource.data.owner == resource.data.owner
        && request.resource.data.memberEmails is list
        && request.resource.data.memberEmails.size() >= 1
        && request.resource.data.memberEmails.size() <= 20
        && myEmail() in request.resource.data.memberEmails;

      // 房間不給刪（底下還有資料，刪了會變孤兒）
      allow delete: if false;

      // 案子清單、名片：名單上的人都能讀寫
      match /{document=**} {
        allow read, write: if isMember(room);
      }
    }

    // 其他路徑一律擋掉
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
